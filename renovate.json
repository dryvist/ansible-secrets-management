{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "github>JacobPEvans/.github"
  ],
  "customManagers": [
    {
      "customType": "regex",
      "description": "Track the OpenBao server version pin in the openbao role defaults against OpenBao release tags.",
      "managerFilePatterns": [
        "/^roles/openbao/defaults/main/.+\\.ya?ml$/"
      ],
      "matchStrings": [
        "openbao_version:\\s*\"(?<currentValue>[0-9.]+)\""
      ],
      "datasourceTemplate": "github-releases",
      "depNameTemplate": "openbao/openbao"
    },
    {
      "customType": "regex",
      "description": "Track the Azure plugin release pin in the openbao role defaults.",
      "managerFilePatterns": [
        "/^roles/openbao/defaults/main/02b-azure-engine\\.ya?ml$/"
      ],
      "matchStrings": [
        "# renovate: datasource=github-releases depName=openbao/openbao-plugins\\s+openbao_azure_plugin_version:\\s*\\\"(?<currentValue>[0-9.]+)\\\""
      ],
      "datasourceTemplate": "github-releases",
      "depNameTemplate": "openbao/openbao-plugins",
      "extractVersionTemplate": "^secrets-azure-v(?<version>.*)$",
      "versioningTemplate": "semver"
    },
    {
      "customType": "regex",
      "description": "Track the pinned Docker image digest in the openbao Molecule scenario.",
      "managerFilePatterns": [
        "/^molecule/openbao/molecule\\.ya?ml$/"
      ],
      "matchStrings": [
        "# renovate: datasource=(?<datasource>\\S+) depName=(?<depName>\\S+)\\s+image:\\s*(?:>-\\s*\\n\\s+)?mirror\\.gcr\\.io/geerlingguy/docker-debian12-ansible:(?<currentValue>[^@\\s]+)@(?<currentDigest>sha256:[A-Fa-f0-9]{64})"
      ],
      "versioningTemplate": "docker"
    }
  ]
}
