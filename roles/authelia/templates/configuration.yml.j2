{{ ansible_managed | comment }}
# Authelia configuration — passkey-first SSO portal + Traefik forwardAuth
# provider. Single instance: in-memory session provider (a restart re-prompts
# the browser; acceptable for a homelab) and local SQLite on the persistent
# data mount. NO secrets live in this file — the JWT/session/storage secrets
# are guest-generated files fed via AUTHELIA_*_FILE env vars in the systemd
# unit (generate-at-source rule; no shared secret store involved).

theme: auto

server:
  address: "tcp://0.0.0.0:{{ authelia_port }}"

log:
  level: info

authentication_backend:
  file:
    path: "{{ authelia_users_file }}"

# Passkey-first login: a discoverable WebAuthn credential logs the user in with
# one Touch ID prompt, no password typed. A passkey alone is only one_factor by
# default, so uv_two_factors lets a user-verifying passkey (Touch ID performs
# user verification) satisfy the two_factor policy on its own — otherwise the
# two_factor routes below would still demand a password after the passkey.
webauthn:
  disable: false
  enable_passkey_login: true
  experimental_enable_passkey_uv_two_factors: true

# Native OIDC is required by Hermes Dashboard before it will bind beyond
# loopback. The client is public and PKCE-only; no reusable client secret exists.
identity_providers:
  oidc:
    hmac_secret: '{{ authelia_oidc_hmac_secret }}'
    jwks:
      - algorithm: RS256
        use: sig
        key: |
{{ authelia_oidc_jwks_key | indent(10, true) }}
    enforce_pkce: public_clients_only
    # Semaphore and terrakube-dex (Dex) both need `groups` in the id_token to
    # gate access on group membership; the default claims set omits it.
    claims_policies:
      semaphore_claims_policy:
        id_token:
          - groups
          - email
          - email_verified
          - preferred_username
          - name
    clients:
      - client_id: '{{ authelia_oidc_hermes_client_id }}'
        client_name: Hermes Dashboard
        public: true
        redirect_uris:
          - '{{ authelia_oidc_hermes_redirect_uri }}'
        scopes:
          - openid
          - profile
          - email
        grant_types:
          - authorization_code
        response_types:
          - code
        authorization_policy: two_factor
        require_pkce: true
        pkce_challenge_method: S256
        token_endpoint_auth_method: none
      - client_id: '{{ authelia_oidc_donna_client_id }}'
        client_name: Donna Dashboard
        public: true
        redirect_uris:
          - '{{ authelia_oidc_donna_redirect_uri }}'
        scopes:
          - openid
          - profile
          - email
        grant_types:
          - authorization_code
        response_types:
          - code
        authorization_policy: two_factor
        require_pkce: true
        pkce_challenge_method: S256
        token_endpoint_auth_method: none
      # Homarr, Langfuse, Semaphore, and terrakube-dex are confidential clients
      # (server-side apps that can hold a secret), so client_secret carries a
      # pbkdf2-sha512 digest (never plaintext) and there is no PKCE. Homarr
      # additionally disables signed token/userinfo responses per Authelia's
      # own documented Homarr integration — its OIDC client does not support
      # OpenID Connect's signed-response mode.
      - client_id: '{{ authelia_oidc_homarr_client_id }}'
        client_name: Homarr
        client_secret: '{{ authelia_oidc_client_secret_hashes.homarr }}'
        public: false
        redirect_uris:
          - '{{ authelia_oidc_homarr_redirect_uri }}'
        scopes:
          - openid
          - profile
          - email
        grant_types:
          - authorization_code
        response_types:
          - code
        authorization_policy: two_factor
        require_pkce: false
        token_endpoint_auth_method: client_secret_basic
        access_token_signed_response_alg: none
        userinfo_signed_response_alg: none
      - client_id: '{{ authelia_oidc_langfuse_client_id }}'
        client_name: Langfuse
        client_secret: '{{ authelia_oidc_client_secret_hashes.langfuse }}'
        public: false
        redirect_uris:
          - '{{ authelia_oidc_langfuse_redirect_uri }}'
        scopes:
          - openid
          - profile
          - email
        grant_types:
          - authorization_code
        response_types:
          - code
        authorization_policy: two_factor
        require_pkce: false
        token_endpoint_auth_method: client_secret_basic
      - client_id: '{{ authelia_oidc_phoenix_client_id }}'
        client_name: Arize Phoenix
        client_secret: '{{ authelia_oidc_client_secret_hashes.phoenix }}'
        public: false
        redirect_uris:
          - '{{ authelia_oidc_phoenix_redirect_uri }}'
        scopes:
          - openid
          - profile
          - email
        grant_types:
          - authorization_code
        response_types:
          - code
        authorization_policy: two_factor
        require_pkce: false
        token_endpoint_auth_method: client_secret_basic
      # Semaphore and terrakube-dex (Dex) both read `groups` from the id_token
      # to gate access, hence claims_policy; neither supports a signed
      # userinfo response, same as Homarr above.
      - client_id: '{{ authelia_oidc_semaphore_client_id }}'
        client_name: Semaphore
        client_secret: '{{ authelia_oidc_client_secret_hashes.semaphore }}'
        public: false
        redirect_uris:
          - '{{ authelia_oidc_semaphore_redirect_uri }}'
        scopes:
          - openid
          - profile
          - email
          - groups
        grant_types:
          - authorization_code
        response_types:
          - code
        authorization_policy: two_factor
        require_pkce: false
        token_endpoint_auth_method: client_secret_basic
        claims_policy: semaphore_claims_policy
        userinfo_signed_response_alg: none
      - client_id: '{{ authelia_oidc_terrakube_dex_client_id }}'
        client_name: Terrakube Dex
        client_secret: '{{ authelia_oidc_client_secret_hashes.terrakube_dex }}'
        public: false
        redirect_uris:
          - '{{ authelia_oidc_terrakube_dex_redirect_uri }}'
        scopes:
          - openid
          - profile
          - email
          - groups
        grant_types:
          - authorization_code
        response_types:
          - code
        authorization_policy: two_factor
        require_pkce: false
        token_endpoint_auth_method: client_secret_basic
        claims_policy: semaphore_claims_policy
        userinfo_signed_response_alg: none
      # Grafana reads no groups claim — its generic_oauth backend maps every
      # SSO user to a fixed role via role_attribute_path, so this client needs
      # neither the groups scope nor a claims policy.
      - client_id: '{{ authelia_oidc_grafana_client_id }}'
        client_name: Grafana
        client_secret: '{{ authelia_oidc_client_secret_hashes.grafana }}'
        public: false
        redirect_uris:
          - '{{ authelia_oidc_grafana_redirect_uri }}'
        scopes:
          - openid
          - profile
          - email
        grant_types:
          - authorization_code
        response_types:
          - code
        authorization_policy: two_factor
        require_pkce: false
        token_endpoint_auth_method: client_secret_basic

access_control:
  default_policy: deny
  rules:
{% for bypass in authelia_api_bypass_domains %}
    # {{ bypass.domain }} authenticates this path prefix itself (per-request
    # token); the portal cannot satisfy a non-browser client. UI paths stay
    # gated below. The prefix is per-entry: an app that serves its browser auth
    # routes under /api must narrow it so the bypass does not expose them.
    - domain: "{{ bypass.domain }}"
      policy: bypass
      resources:
        - "{{ bypass.resource | default(authelia_api_bypass_default_resource) }}"
{% endfor %}
    # Every Traefik-fronted UI under the ingress base domain. two_factor is
    # required so Authelia exposes passkey/WebAuthn enrolment at all (it hides
    # it when nothing needs a second factor); a UV passkey satisfies it in one
    # Touch ID gesture via webauthn.experimental_enable_passkey_uv_two_factors.
    - domain: "*.{{ authelia_cookie_domain }}"
      policy: two_factor

session:
  cookies:
    - domain: "{{ authelia_cookie_domain }}"
      authelia_url: "{{ authelia_portal_url }}"
      expiration: "{{ authelia_session_expiration }}"
      inactivity: "{{ authelia_session_inactivity }}"
      remember_me: "{{ authelia_session_remember_me }}"

regulation:
  max_retries: 3
  find_time: "2m"
  ban_time: "5m"

storage:
  local:
    path: "{{ authelia_db_path }}"

notifier:
  # crit-1 service must not crashloop when a downstream is briefly unreachable
  # at boot; passkey-first login never touches the notifier anyway.
  disable_startup_check: true
  # Filesystem backend, not SMTP: auth-critical flows (passkey enrolment's
  # one-time code, password reset) must not depend on mail/DNS reachability in
  # a single-user homelab. The code is written here and read by the operator.
  filesystem:
    filename: "{{ authelia_notification_file }}"
