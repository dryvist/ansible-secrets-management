{{ ansible_managed | comment }}
path "{{ openbao_kv_mount }}/data/ai/hermes-private" {
  capabilities = ["read"]
}
path "{{ openbao_kv_mount }}/metadata/ai/hermes-private" {
  capabilities = ["read", "list"]
}

{%- if 'splunk' not in openbao_roster_owned_slug_names | default([]) %}

path "{{ openbao_kv_mount }}/data/ai/mcp/splunk" {
  capabilities = ["read"]
}
path "{{ openbao_kv_mount }}/metadata/ai/mcp/splunk" {
  capabilities = ["read", "list"]
}
{%- else -%}
{%- endif -%}
