{{ ansible_managed | comment }}
# github-admin — break-glass. Mints the admin-tier *-full-automation permission
# sets at the App's full installed ceiling. Exactly why the
# github-admin AppRole is provisioned INERT (manage_secret_id: false): no
# standing secret_id exists, a human response-wraps a single-use secret_id per
# elevation, and the resulting token lives minutes. Raw token minting accepts
# an owner selector and uses the App ceiling; engine configuration and
# permissionset administration paths remain absent.
path "{{ openbao_github_mount }}/token" {
  capabilities = ["create", "update"]
  required_parameters = ["org_name"]
  allowed_parameters = {
    "org_name" = []
    "repositories" = []
  }
  denied_parameters = {
    "installation_id" = []
  }
}

{% for permission_set in openbao_github_permission_sets | selectattr('tier', 'equalto', 'admin') %}
path "{{ permission_set.mount }}/token/{{ permission_set.name }}" {
  capabilities = ["create", "update"]
}

{% endfor %}
