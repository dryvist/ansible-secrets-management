{{ ansible_managed | comment }}
# OpenBao policy for the apps AppRole — the shared-Postgres application tier
# (openbao_secrets domain "apps"). Read-only, generated from
# openbao_apps_read_apps (generated, promoted, router-key, and published apps)
# so the policy stays in lockstep with the seeded apps and never subsumes sibling
# domains that also live under apps/ (e.g. apps/media belongs to the media AppRole).

{% for app in openbao_apps_read_apps %}
path "{{ openbao_kv_mount }}/data/apps/{{ app }}" {
  capabilities = ["read"]
}

path "{{ openbao_kv_mount }}/metadata/apps/{{ app }}" {
  capabilities = ["read", "list"]
}
{% endfor %}
# Exact-path exception (UniFi controller connection): the openbao_secrets
# "apps" domain also fetches secret/infrastructure/unifi (unpoller,
# unifi_metrics) — see playbooks/group_vars/all/openbao_secrets.yml.
# Read-only, single path, deliberately NOT an infrastructure/* wildcard: the
# apps AppRole must never gain read on the rest of the infrastructure/*
# subtree just to reach this one controller URL.
path "{{ openbao_kv_mount }}/data/infrastructure/unifi" {
  capabilities = ["read"]
}

path "{{ openbao_kv_mount }}/metadata/infrastructure/unifi" {
  capabilities = ["read"]
}

# Read-only access for the Homebox service API key.
path "{{ openbao_kv_mount }}/data/homebox/main/rw" {
  capabilities = ["read"]
}

path "{{ openbao_kv_mount }}/metadata/homebox/main/rw" {
  capabilities = ["read"]
}

# Read-only access for the PostgreSQL backup credential domain.
path "{{ openbao_kv_mount }}/data/rustfs/dryvist-homelab-backups/rw" {
  capabilities = ["read"]
}

# Read-only access for the Homebox backup credential domain.
path "{{ openbao_kv_mount }}/data/rustfs/dryvist-homebox-backups/rw" {
  capabilities = ["read"]
}

# Exact-path read on the external-SaaS mount for the Homebox Backblaze B2 keys
# (homebox_backup_b2). Literal mount name, not openbao_kv_mount, and no wildcard:
# on secrets-external the apps reader gets only the exact leaves granted below.
path "secrets-external/data/backblaze/dryvist-homebox-backups/rw" {
  capabilities = ["read"]
}

path "secrets-external/metadata/backblaze/dryvist-homebox-backups/rw" {
  capabilities = ["read"]
}

# Same shape for the Nautobot Backblaze B2 keys (nautobot_backup_b2): one bucket,
# one exact path, no wildcard.
path "secrets-external/data/backblaze/dryvist-nautobot-backups/rw" {
  capabilities = ["read"]
}

path "secrets-external/metadata/backblaze/dryvist-nautobot-backups/rw" {
  capabilities = ["read"]
}

# Exact-path read of the OpenCode Go key. One leaf, no wildcard.
path "secrets-external/data/ai/saas/opencode" {
  capabilities = ["read"]
}

# Exact-path read of the Slack ops leaf (grafana-alerts domain reads it).
# One leaf, no wildcard.
# Transitional: the platform/ path is removed once every consumer reads the slack/ path.
path "secrets-external/data/platform/slack-ops" {
  capabilities = ["read"]
}

path "secrets-external/data/slack/homelab-ops/rw" {
  capabilities = ["read"]
}

# Transitional: the platform/ path is removed once every consumer reads the slack/ path.
path "secrets-external/metadata/platform/slack-ops" {
  capabilities = ["read"]
}

path "secrets-external/metadata/slack/homelab-ops/rw" {
  capabilities = ["read"]
}
