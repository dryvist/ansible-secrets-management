{{ ansible_managed | comment }}
# Sandbox leaf read access and public repository write tokens.
path "{{ openbao_github_agents_mount }}/token/public-write" {
  capabilities = ["create", "update"]
}

path "{{ openbao_kv_mount }}/data/apps/sandbox-agent" {
  capabilities = ["read"]
}

path "{{ openbao_kv_mount }}/data/apps/sandbox-agent-router" {
  capabilities = ["read"]
}
