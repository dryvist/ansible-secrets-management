{{ ansible_managed | comment }}
# github-read — the workstation's standing, ambient READ tier. Mints the
# read-tier permission sets and a raw token with the same fixed read map. The
# owner and optional repository selector are chosen at mint time; the map is
# fixed by this policy. Admin sets and engine administration paths are absent.
{% for permission_set in openbao_github_permission_sets | selectattr('tier', 'equalto', 'read') %}
path "{{ permission_set.mount }}/token/{{ permission_set.name }}" {
  capabilities = ["create", "update"]
}

{% endfor %}

path "{{ openbao_github_everyday_mount }}/token" {
  capabilities = ["create", "update"]
  required_parameters = ["org_name", "permissions"]
  allowed_parameters = {
    "org_name" = []
    "repositories" = []
    "permissions" = [{ {% for name, level in openbao_github_read_permissions | dictsort %}"{{ name }}" = "{{ level }}"{{ ", " if not loop.last else "" }}{% endfor %} }]
  }
  denied_parameters = {
    "installation_id" = []
  }
}
