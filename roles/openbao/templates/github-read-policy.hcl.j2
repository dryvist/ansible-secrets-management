{{ ansible_managed | comment }}
# github-read — the workstation's standing, ambient READ tier. The caller
# selects an installed organization by name; this policy pins the read map.

path "{{ openbao_github_everyday_mount }}/token" {
  capabilities = ["create", "update"]
  required_parameters = ["org_name", "permissions"]
  allowed_parameters = {
    "org_name" = []
    "repositories" = []
    "permissions" = [{ {% for name, level in openbao_github_read_permissions | dictsort %}"{{ name }}" = "{{ level }}"{{ ", " if not loop.last else "" }}{% endfor %} }]
  }
  denied_parameters = {
    "installation_id" = []
  }
}
