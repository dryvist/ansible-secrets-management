               'organization:' ~ openbao_terrakube_organization
               ~ ':workspace:' ~ terrakube_workspace.name ~ '-*']
              if terrakube_workspace.name == 'tofu-github'
              else 'organization:' ~ openbao_terrakube_organization
                   ~ ':workspace:' ~ terrakube_workspace.name)},
    'user_claim': 'sub',
    'bound_claims_type': 'glob' if terrakube_workspace.name == 'tofu-github' else 'string',
    'policies': (['terrakube-' ~ terrakube_workspace.name]
