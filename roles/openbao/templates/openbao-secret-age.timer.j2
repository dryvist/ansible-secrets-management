{{ ansible_managed | comment }}
# Fire the OpenBao secret-age auditor at {{ openbao_secret_age_schedule }}.
# Rendered by the openbao role.

[Unit]
Description=Audit OpenBao secret age at {{ openbao_secret_age_schedule }}
Documentation=https://github.com/dryvist/ansible-secrets-management

[Timer]
# Run once daily at the configured UTC time. Persistent=true runs a missed
# audit after downtime.
OnCalendar={{ openbao_secret_age_schedule }}
AccuracySec=1m
Persistent=true

[Install]
WantedBy=timers.target
