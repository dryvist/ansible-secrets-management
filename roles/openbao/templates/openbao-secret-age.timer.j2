{{ ansible_managed | comment }}
# Fire the OpenBao secret-age auditor every {{ openbao_secret_age_interval }}.
# Rendered by the openbao role.

[Unit]
Description={{ openbao_secret_age_timer_description | default('Audit OpenBao secret age every ' ~ openbao_secret_age_interval) }}
Documentation=https://github.com/dryvist/ansible-secrets-management

[Timer]
# Start a few minutes after boot (let the node join + unseal first), then on a
# fixed cadence. Persistent=true runs a missed audit after downtime.
OnBootSec=300s
OnUnitActiveSec={{ openbao_secret_age_interval }}
AccuracySec=1m
Persistent=true

[Install]
WantedBy=timers.target
