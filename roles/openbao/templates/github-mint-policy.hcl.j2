{{ ansible_managed | comment }}
# BASE CAPABILITY policy `github-mint` — actor-agnostic, mint-only. Grants a raw
# token for reads with a fixed map. Non-read permission sets and the engine's
# config/* + permissionset/* administration paths are ABSENT.
# Per-repo WRITE minting is the github-write identity's policy alone; an estate
# identity that needs repo write gets its own parameter-pinned grant, never
# this leaf widened. Publish and ci-resolver sets carry stored write maps and
# are reserved for their dedicated identities. The repo-create tier carries
# administration:write, which GitHub requires to create or delete a repo.
# Select only the read tier so any future write tier stays out by default.
# Attached (via token_policies) to the apply-tier actor roles; carries no
# self-escalation path, so composing it with KV leaves is safe.
{% for permission_set in openbao_github_permission_sets
   | selectattr('tier', 'equalto', 'read') %}
path "{{ permission_set.mount }}/token/{{ permission_set.name }}" {
  capabilities = ["create", "update"]
}

{% endfor %}

path "{{ openbao_github_everyday_mount }}/token" {
  capabilities = ["create", "update"]
  required_parameters = ["org_name", "permissions"]
  allowed_parameters = {
    "org_name" = []
    "repositories" = []
    "permissions" = [{ {% for name, level in openbao_github_read_permissions | dictsort %}"{{ name }}" = "{{ level }}"{{ ", " if not loop.last else "" }}{% endfor %} }]
  }
  denied_parameters = {
    "installation_id" = []
  }
}
