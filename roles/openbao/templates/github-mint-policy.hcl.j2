{{ ansible_managed | comment }}
# BASE CAPABILITY policy `github-mint` — actor-agnostic, mint-only. Grants ONLY
# the READ-tier GitHub App permission sets (ephemeral installation tokens) so a
# run's API reads are attributed to a per-run token, not a standing PAT. The
# admin-tier *-full-automation sets (installation-wide, full App ceiling) and
# the engine's config/* + permissionset/* administration paths are ABSENT. A
# raw token grant allows owner/repository selection while pinning the same
# fixed read map as the read sets.
# Per-repo WRITE minting is the github-write identity's policy alone; an estate
# identity that needs repo write gets its own parameter-pinned grant, never
# this leaf widened. The publish tier is rejected here for that reason: its
# sets carry a stored write permission map, so leaving it in would hand every
# apply-tier actor the publisher's grant. The ci-resolver tier is rejected too;
# its stored write set is reserved for one service. The repo-create tier is
# rejected for the same reason and a sharper one: administration:write is the one
# permission GitHub requires to create or delete a repository, so leaking it
# to every apply-tier actor is strictly worse than leaking a per-repo write
# grant. Attached (via token_policies) to the apply-tier actor roles; carries
# no self-escalation path, so composing it with KV leaves is safe.
{% for permission_set in openbao_github_permission_sets
   | rejectattr('tier', 'equalto', 'admin')
   | rejectattr('tier', 'equalto', 'publish')
   | rejectattr('tier', 'equalto', 'ci-resolver')
   | rejectattr('tier', 'equalto', 'repo-create')
   | rejectattr('tier', 'equalto', 'org-admin')
   | rejectattr('tier', 'equalto', 'agents') %}
path "{{ permission_set.mount }}/token/{{ permission_set.name }}" {
  capabilities = ["create", "update"]
}

{% endfor %}

path "{{ openbao_github_everyday_mount }}/token" {
  capabilities = ["create", "update"]
  required_parameters = ["org_name", "permissions"]
  allowed_parameters = {
    "org_name" = []
    "repositories" = []
    "permissions" = [{ {% for name, level in openbao_github_read_permissions | dictsort %}"{{ name }}" = "{{ level }}"{{ ", " if not loop.last else "" }}{% endfor %} }]
  }
  denied_parameters = {
    "installation_id" = []
  }
}
