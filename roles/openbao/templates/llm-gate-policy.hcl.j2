{{ ansible_managed | comment }}
# OpenBao policy for the `llm-gate` AppRole — the Mac Studio's llm-large Caddy
# gate. Least-privilege reader for EXACTLY the secrets it injects via
# openbao-run: the bearer token Caddy enforces (secret/ai/llm), the Route53
# ACME credentials for its Let's Encrypt cert (platform/acme, shared with the
# traefik ingress), and the router key of the same host's local LLM proxy
# (secret/apps/litellm-local, data only). Nothing else in the ai, apps or
# platform subtrees, or any other domain.
#
# platform/acme is dual-mounted during the secrets-external migration: the
# Route53 ACME credential is an internet-reachable SaaS credential, so its
# canonical home is moving to the secrets-external mount (literal below, not
# openbao_kv_mount — that var is the internal mount). Both grants stay live
# until the original internal-mount platform/acme entry is deleted.
path "{{ openbao_kv_mount }}/data/ai/llm" {
  capabilities = ["read"]
}
path "{{ openbao_kv_mount }}/metadata/ai/llm" {
  capabilities = ["read", "list"]
}
path "{{ openbao_kv_mount }}/data/platform/acme" {
  capabilities = ["read"]
}
path "{{ openbao_kv_mount }}/metadata/platform/acme" {
  capabilities = ["read", "list"]
}
path "secrets-external/data/platform/acme" {
  capabilities = ["read"]
}
path "secrets-external/metadata/platform/acme" {
  capabilities = ["read", "list"]
}
path "{{ openbao_kv_mount }}/data/apps/litellm-local" {
  capabilities = ["read"]
}
