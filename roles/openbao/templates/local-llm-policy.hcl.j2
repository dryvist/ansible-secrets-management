{{ ansible_managed | comment }}
# OpenBao policy for the local-llm AppRole — the local LLM serving stack
# (llama_cpp/llm_router/open_webui/qdrant/hermes and similar). Read-only on
# the full ai subtree, no access to the infra kernel or other platform/apps
# services. Distinct from ai-readonly/ai-elevated, which are for AI AGENTS
# consuming these same secrets, not the serving stack itself.

path "{{ openbao_kv_mount }}/data/ai/*" {
  capabilities = ["read"]
}

path "{{ openbao_kv_mount }}/metadata/ai/*" {
  capabilities = ["read", "list"]
}

# Keep the retired internal provider-key area out of the broad ai/* grant.
# External provider keys use exact leaves; this deny keeps internal ai/saas closed.
path "{{ openbao_kv_mount }}/data/ai/saas/*" {
  capabilities = ["deny"]
}

path "{{ openbao_kv_mount }}/metadata/ai/saas/*" {
  capabilities = ["deny"]
}

# QwenCloud's external leaf is separate from the denied internal mount.
path "secrets-external/data/ai/saas/qwencloud" {
  capabilities = ["read"]
}

# The ClickHouse credentials are read only through the clickhouse AppRole.
path "{{ openbao_kv_mount }}/data/ai/clickhouse" {
  capabilities = ["deny"]
}

path "{{ openbao_kv_mount }}/metadata/ai/clickhouse" {
  capabilities = ["deny"]
}

# The ClickHouse ingest writer password is read only through the clickhouse-ingest AppRole.
path "{{ openbao_kv_mount }}/data/ai/clickhouse-ingest" {
  capabilities = ["deny"]
}

path "{{ openbao_kv_mount }}/metadata/ai/clickhouse-ingest" {
  capabilities = ["deny"]
}

# The ClickHouse wall reader password is read only through the clickhouse-wall AppRole.
path "{{ openbao_kv_mount }}/data/ai/clickhouse-wall" {
  capabilities = ["deny"]
}

path "{{ openbao_kv_mount }}/metadata/ai/clickhouse-wall" {
  capabilities = ["deny"]
}
