{{ ansible_managed | comment }}
# Read only the declared org-secrets KV-v2 source leaves.
path "{{ openbao_github_org_secrets_mount }}/data/{{ openbao_github_org_disclosure_denylist_path }}" {
  capabilities = ["read"]
}

path "{{ openbao_github_org_secrets_mount }}/data/{{ openbao_github_org_gitleaks_path }}" {
  capabilities = ["read"]
}

path "{{ openbao_github_org_secrets_mount }}/data/{{ openbao_github_org_release_key_path }}" {
  capabilities = ["read"]
}
