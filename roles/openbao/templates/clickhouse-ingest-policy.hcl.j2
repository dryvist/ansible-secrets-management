{{ ansible_managed | comment }}
# OpenBao policy for the clickhouse-ingest AppRole. Reads only the ClickHouse
# ingest writer password at the exact internal KV leaf.
path "{{ openbao_kv_mount }}/data/ai/clickhouse-ingest" {
  capabilities = ["read"]
}
path "{{ openbao_kv_mount }}/metadata/ai/clickhouse-ingest" {
  capabilities = ["read"]
}
