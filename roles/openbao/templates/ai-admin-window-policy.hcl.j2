{{ ansible_managed | comment }}
# Finite exact-name grants used by the selected ai-admin-session RBAC path.
# This policy is paired with ai-admin-guard; neither it nor the token has a
# wildcard policy or AppRole write path.

path "sys/capabilities-self" {
  capabilities = ["create", "update"]
}
path "sys/policies/acl" {
  capabilities = ["list"]
}

{% for _policy in openbao_ai_admin_window_manageable_policies %}
{% set _policy_body = lookup('template', _policy.template, template_vars={'item': _policy}) | trim | regex_replace('$', '\n') %}
path "sys/policies/acl/{{ _policy.name }}" {
  capabilities = ["create", "read", "update"]
  allowed_parameters = {
    "policy" = [{{ _policy_body | tojson }}]
  }
}
{% endfor %}

# The reconcile policy is synchronized only when explicitly selected. Its
# rendered contents stay pinned to the checked-in template.
{% set _reconcile_policy_body = lookup('template', 'openbao-reconcile-policy.hcl.j2') | trim | regex_replace('$', '\n') %}
path "sys/policies/acl/{{ openbao_reconcile_policy_name }}" {
  capabilities = ["create", "read", "update"]
  allowed_parameters = {
    "policy" = [{{ _reconcile_policy_body | tojson }}]
  }
}

{% for _approle in openbao_ai_admin_window_manageable_approles %}
{% set _parameters = openbao_approle_cli_parameters[_approle.name] %}
{% set _cidrs = _parameters.secret_id_bound_cidrs.split(',') | map('trim') | reject('equalto', '') | list %}
{% set _required = ['token_policies', 'bind_secret_id', 'token_ttl', 'token_max_ttl', 'token_explicit_max_ttl', 'token_type', 'secret_id_ttl', 'secret_id_num_uses'] %}
{% if _cidrs | length > 0 %}
{% set _ = _required.extend(['secret_id_bound_cidrs', 'token_bound_cidrs']) %}
{% endif %}
path "auth/approle/role/{{ _approle.name }}" {
  capabilities = ["create", "read", "update"]
  allowed_parameters = {
    "token_policies"         = [{{ _parameters.token_policies | tojson }}]
    "bind_secret_id"         = [{{ _parameters.bind_secret_id | tojson }}]
{% if _cidrs | length > 0 %}
    "secret_id_bound_cidrs"  = [{{ _parameters.secret_id_bound_cidrs | tojson }}]
    "token_bound_cidrs"      = [{{ _parameters.token_bound_cidrs | tojson }}]
{% endif %}
    "token_ttl"              = [{{ _parameters.token_ttl | tojson }}]
    "token_max_ttl"          = [{{ _parameters.token_max_ttl | tojson }}]
    "token_explicit_max_ttl" = [{{ _parameters.token_explicit_max_ttl | tojson }}]
    "token_type"             = [{{ _parameters.token_type | tojson }}]
    "secret_id_ttl"           = [{{ _parameters.secret_id_ttl | tojson }}]
    "secret_id_num_uses"     = [{{ _parameters.secret_id_num_uses | tojson }}]
  }
  required_parameters = {{ _required | tojson }}
}
path "auth/approle/role/{{ _approle.name }}/policies" {
  capabilities = ["create", "update"]
  allowed_parameters = {
    "token_policies" = [{{ _parameters.token_policies | tojson }}]
  }
  required_parameters = ["token_policies"]
}
{% endfor %}
