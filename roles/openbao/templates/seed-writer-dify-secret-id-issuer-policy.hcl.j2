{{ ansible_managed | comment }}
# Issues the Dify agent SecretIDs. For each Dify agent AppRole in
# openbao_dify_agent_approles: read its role-id, create, update and list its
# secret-id, and look up or destroy a secret-id by accessor. Exact paths only.
# This policy is attached to the dify-agent-secret-id-issuer AppRole only (07i).
{% for name in openbao_dify_agent_approles | map(attribute='name') %}

path "auth/approle/role/{{ name }}/role-id" {
  capabilities = ["read"]
}

path "auth/approle/role/{{ name }}/secret-id" {
  capabilities = ["create", "update", "list"]
}

path "auth/approle/role/{{ name }}/secret-id-accessor/lookup" {
  capabilities = ["update"]
}

path "auth/approle/role/{{ name }}/secret-id-accessor/destroy" {
  capabilities = ["update"]
}
{% endfor %}
