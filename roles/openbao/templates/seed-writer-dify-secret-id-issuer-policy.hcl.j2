{{ ansible_managed | comment }}
# Issues the SecretIDs of the AppRoles named in item.targets: for each one, read
# its role-id, create, update and list its secret-id, and look up or destroy a
# secret-id by accessor. Exact paths only. Attached to the Dify secret-id issuer
# AppRole only (07i).
{% if (item.targets | default([]) | length) == 0 %}
{{ undef(hint='seed-writer-dify-secret-id-issuer: item.targets must name at least one AppRole') }}
{% endif %}
{% for name in item.targets %}
{% if name is not string or name is not match(openbao_roster_agent_slug_pattern) %}
{{ undef(hint='seed-writer-dify-secret-id-issuer: item.targets[' ~ loop.index0 ~ '] must match openbao_roster_agent_slug_pattern') }}
{% endif %}

path "auth/approle/role/{{ name }}/role-id" {
  capabilities = ["read"]
}

path "auth/approle/role/{{ name }}/secret-id" {
  capabilities = ["create", "update", "list"]
}

path "auth/approle/role/{{ name }}/secret-id-accessor/lookup" {
  capabilities = ["update"]
}

path "auth/approle/role/{{ name }}/secret-id-accessor/destroy" {
  capabilities = ["update"]
}
{% endfor %}
