#!/usr/bin/env bash
# {{ ansible_managed }}
#
# Automated OpenBao raft snapshot. Rendered by the openbao role and run on a
# systemd timer (every {{ openbao_snapshot_interval }}). Deployed on every
# openbao node, but only the ACTIVE node acts — standby nodes exit 0 as a no-op,
# so exactly one snapshot is taken per cycle regardless of who holds leadership.
#
# It talks to THIS node's loopback listener, never the Traefik ingress VIP. The
# local listener permits plain HTTP only on loopback, so the AppRole helper's
# client-side transport guard remains in force and no credential crosses the
# network. The leader check still ensures only the active node takes a snapshot.
# It authenticates with the least-privilege `snapshot` AppRole
# (sys/storage/raft/snapshot read only).
#
# Each snapshot is integrity-checked (gzip -t — raft snapshots are gzipped tar)
# and written under the data volume, which sits on a ZFS/PBS-backed dataset that
# replicates OFF-BOX; the newest {{ openbao_snapshot_retain }} are kept locally.
# A second off-box copy into the RustFS `openbao-snapshots` S3 bucket and a full
# restore-to-scratch drill are tracked follow-ups (see roles/openbao/README.md):
# these WAN-firewalled nodes cannot be handed a checksum-verifiable S3 client
# WAN-free, and ZFS replication already carries snapshots off-box in the meantime.
#
# NOT `set -e`: every failure is handled explicitly so it ALERTS (ntfy +
# healthchecks) instead of aborting silently.
#
# journald marker (logger -t openbao-snapshot), for Splunk alert rules:
#   success: "snapshot OK: <path> (<bytes> bytes)"
#   failure: "OpenBao snapshot FAILED on <host>: <reason>"
#   no-op:   "not the active node — nothing to do"
set -uo pipefail

BIN="{{ openbao_install_dir }}/bao"
SNAP_DIR="{{ openbao_snapshot_dir }}"
RETAIN="{{ openbao_snapshot_retain }}"
NTFY_URL="{{ openbao_snapshot_ntfy_url }}"
HC_URL="{{ openbao_snapshot_healthcheck_url }}"
HOST="$(hostname)"

log() { logger -t openbao-snapshot "$*"; echo "openbao-snapshot: $*"; }

# Ping a healthchecks endpoint if one is configured; no-op otherwise. $1 is the
# suffix: "" for the OK ping, "/fail" to signal a breach.
hc_ping() {
  [ -n "${HC_URL}" ] || return 0
  curl -fsS --max-time 8 "${HC_URL}$1" >/dev/null 2>&1 || true
}

# Alert + signal the deadman failure endpoint, then exit non-zero.
fail() {
  local msg="OpenBao snapshot FAILED on ${HOST}: $*"
  log "${msg}"
  if [ -n "${NTFY_URL}" ]; then
    curl -fsS --max-time 8 -H "Title: openbao snapshot" -H "Priority: urgent" \
      -H "Tags: rotating_light" -d "${msg}" "${NTFY_URL}" >/dev/null 2>&1 || true
  fi
  hc_ping /fail
  exit 1
}

# Every external binary these timer payloads need, checked once, up front.
# Without this a missing one surfaces as whatever the first command using it
# was doing: a missing curl read as "sys/leader unreachable", which points at
# the cluster rather than at the package that is not installed, and a missing
# jq would make every node decide it was a standby and snapshot nothing at all.
# Keep the marker line in sync with the loop — Molecule reads it to check the
# role actually installs what the script calls.
# requires: bao-approle curl jq
require_binaries() {
  local missing=""
  [ -x "${BIN}" ] || missing="${BIN}"
  for _bin in $(sed -n 's/^# requires: //p' "$0"); do
    command -v "${_bin}" >/dev/null 2>&1 || missing="${missing} ${_bin}"
  done
  [ -z "${missing# }" ] || fail "required binary not installed:${missing# }"
}
require_binaries

BAO_ADDR="http://127.0.0.1:{{ openbao_api_port }}"
export BAO_ADDR

# 1. Leader-gate. /sys/leader is unauthenticated; is_self=true only on the
#    active node. A standby is a clean no-op so peers never double-ship.
#    A curl failure is NOT a standby: collapsing it into the no-op made a
#    cluster-wide snapshot miss look healthy. Fail that so the deadman fires.
leader_json="$(mktemp)"
if ! curl -fsS --max-time 8 -o "${leader_json}" "${BAO_ADDR}/v1/sys/leader"; then
  rm -f "${leader_json}"
  fail "local sys/leader unreachable (not a standby no-op)"
fi
if ! jq -e '.is_self == true' "${leader_json}" >/dev/null 2>&1; then
  rm -f "${leader_json}"
  log "not the active node — nothing to do"
  exit 0
fi
rm -f "${leader_json}"

# 2. Health-gate: never snapshot a sealed/unhealthy node (standbyok=true so an
#    unsealed standby still reads 200; sealed=503, uninitialized=501).
code="$(curl -s -o /dev/null -w '%{http_code}' --max-time 8 \
  "${BAO_ADDR}/v1/sys/health?standbyok=true")"
[ "${code}" = "200" ] || fail "health check returned HTTP ${code} (expected 200)"

# 3. Authenticate with the least-privilege snapshot AppRole through the shared
#    bao-approle CLI, which prints only the client token. The diagnostic file
#    is removed by the EXIT trap set right after its mktemp — a kill between
#    that mktemp and the explicit removals below cannot orphan it — and INT
#    and TERM exit through the same trap (rm -f tolerates the explicit
#    removals having run first).
login_stderr_file="$(mktemp)" || fail "could not create AppRole login diagnostic file"
trap 'rm -f "${login_stderr_file}"' EXIT
trap 'exit 130' INT
trap 'exit 143' TERM
if ! token="$(
  BAO_APPROLE_ROLE_ID="${OPENBAO_SNAPSHOT_ROLE_ID}" \
    BAO_APPROLE_SECRET_ID="${OPENBAO_SNAPSHOT_SECRET_ID}" \
    bao-approle login 2>"${login_stderr_file}"
)" || [ -z "${token}" ]; then
  login_diagnostic="$(<"${login_stderr_file}")"
  for _sensitive in "${token}" "${OPENBAO_SNAPSHOT_ROLE_ID:-}" "${OPENBAO_SNAPSHOT_SECRET_ID:-}"; do
    if [ -n "${_sensitive}" ]; then
      login_diagnostic="${login_diagnostic//"${_sensitive}"/[REDACTED]}"
    fi
  done
  rm -f "${login_stderr_file}"
  fail "snapshot AppRole login failed: ${login_diagnostic:-bao-approle returned no diagnostic}"
fi
rm -f "${login_stderr_file}"

# 4. Take the snapshot.
ts="$(date -u +%Y%m%dT%H%M%SZ)"
snap="${SNAP_DIR}/openbao-${HOST}-${ts}.snap"
BAO_TOKEN="${token}" "${BIN}" operator raft snapshot save "${snap}" \
  || fail "raft snapshot save failed"

# 5. Integrity: raft snapshots are gzipped tar — gzip -t catches a truncated or
#    corrupt file before we trust it as a backup.
gzip -t "${snap}" 2>/dev/null || fail "snapshot ${snap} failed gzip integrity check"
size="$(stat -c%s "${snap}" 2>/dev/null || echo 0)"
[ "${size}" -gt 0 ] || fail "snapshot ${snap} is empty"

# 6. Prune: keep the newest ${RETAIN}, drop the rest. Bounds the local footprint;
#    off-box durability is the ZFS/PBS replication of the data volume.
# shellcheck disable=SC2012  # names are timestamped + controlled; ls -t is fine.
ls -1t "${SNAP_DIR}"/openbao-*.snap 2>/dev/null | tail -n "+$((RETAIN + 1))" \
  | while read -r old; do
      rm -f "${old}" && log "pruned old snapshot ${old}"
    done

log "snapshot OK: ${snap} (${size} bytes)"
hc_ping ""
exit 0
