{{ ansible_managed | comment }}
# Read only the private and OSS review keys and this workflow's base URL.
path "{{ openbao_kv_mount }}/data/apps/github-actions-pr-review" {
  capabilities = ["read"]
}

path "{{ openbao_kv_mount }}/data/apps/github-actions-oss" {
  capabilities = ["read"]
}

path "{{ openbao_config_mount }}/data/{{ openbao_ci_ai_review_config_path }}" {
  capabilities = ["read"]
}
