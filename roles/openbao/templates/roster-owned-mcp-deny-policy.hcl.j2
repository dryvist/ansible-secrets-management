{{ ansible_managed | comment }}
# Deny roster-owned MCP credentials to shared readers.
{% for slug in openbao_roster_owned_slug_names | default([]) %}
path "{{ openbao_kv_mount }}/data/ai/mcp/{{ slug }}" {
  capabilities = ["deny"]
}

path "{{ openbao_kv_mount }}/metadata/ai/mcp/{{ slug }}" {
  capabilities = ["deny"]
}
{% endfor %}
