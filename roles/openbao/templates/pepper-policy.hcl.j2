{{ ansible_managed | comment }}
path "{{ openbao_github_pepper_mount }}/token/{{ openbao_github_pepper_read_set_name }}" {
  capabilities = ["create", "update"]
}

path "{{ openbao_kv_mount }}/data/youtrack/pepper/rw" {
  capabilities = ["read"]
}
path "secrets-external/data/slack/pepper/rw" {
  capabilities = ["read"]
}
path "secrets-external/metadata/slack/pepper/rw" {
  capabilities = ["read"]
}
path "{{ openbao_kv_mount }}/data/apps/pepper" {
  capabilities = ["read"]
}
