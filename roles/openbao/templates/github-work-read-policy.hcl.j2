{{ ansible_managed | comment }}
# github-work-read — the work identity's standing READ tier on the
# {{ openbao_github_work_mount }} mount. It mints only the derived `read` set
# (05b-github-app-mount.yml): the standard read list cut to what the App
# grants. A set path ignores request bodies, so every mint here is read.
{% if openbao_github_work_installation_id is match('^[0-9]+$') %}
path "{{ openbao_github_work_mount }}/token/read" {
  capabilities = ["create", "update"]
}
{% endif %}
