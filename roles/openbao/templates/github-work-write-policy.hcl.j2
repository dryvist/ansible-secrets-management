{{ ansible_managed | comment }}
# github-work-write — the work identity's WRITE tier on the
# {{ openbao_github_work_mount }} mount, live only inside its YubiKey unlock.
# A mint names its repositories and sends no permissions, so the token carries
# exactly what the App grants. A mint without repositories is refused rather
# than covering the whole installation. installation_id is denied.
{% if openbao_github_work_installation_id is match('^[0-9]+$') %}
path "{{ openbao_github_work_mount }}/token" {
  capabilities = ["create", "update"]
  required_parameters = ["org_name", "repositories"]
  allowed_parameters = {
    "org_name" = []
    "repositories" = []
  }
  denied_parameters = {
    "installation_id" = []
  }
}
{% endif %}
