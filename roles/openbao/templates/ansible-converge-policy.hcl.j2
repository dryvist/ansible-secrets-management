{{ ansible_managed | comment }}
path "{{ openbao_kv_mount }}/data/{{ openbao_proxman_secret_path }}" {
  capabilities = ["create", "read", "update"]
}

# OpenBao policy for the ansible-converge AppRole. Reads are enumerated; only
# exact publisher and seed paths are writable. No platform/*, apps/*, or
# secret/infra/* access is granted.
#
# Consumer inventory: each listed read has a current consumer. Resource-domain
# reads (observability, local-cloud, monitoring, media, apps, local-llm) use the
# shared openbao_secrets role's separate AppRoles and are intentionally absent.
#
#   platform/object-storage: inventory_resolve in proxmox, apps, ai, and splunk
#     reads the tofu-published RustFS inventory artifact.
#   platform/windows-vdi/win11-admin: inventory/load_tofu.yml resolves the
#     WinRM admin password; windows_baseline authenticates with it. Read only.
#   platform/defaults: windows_baseline reads admin_password for VDI admin
#     access. This grants the exact KV object, never platform/defaults/*.
#   apps/nas: nas_storage resolves role-selected Samba username/password for
#     declared SMB shares (main.yml and validate-nas.yml). Read only.
#
# apps/nautobot is granted once by the publication loop below. Do not add a
# duplicate stanza: the publisher grant already includes the required read.

{% for kv_path in ['platform/object-storage', 'platform/windows-vdi/win11-admin', 'platform/defaults', 'apps/nas'] %}
path "{{ openbao_kv_mount }}/data/{{ kv_path }}" {
  capabilities = ["read"]
}

path "{{ openbao_kv_mount }}/metadata/{{ kv_path }}" {
  capabilities = ["read", "list"]
}

{% endfor %}
# Transitional exact-path exception: ansible-splunk's converge publishes the
# shared Splunk MCP connection (SPLUNK_MCP_URL + the minted SPLUNK_MCP_TOKEN)
# here. Narrow create/update/read on the SINGLE secret — deliberately NOT a
# wildcard and NOT blanket secret/ai/* write (that stays with ai-orchestrator).
# `read` is required: the publisher does a read-modify-write to preserve sibling
# fields. This follows the same exact-path scoping pattern as hermes-write.
path "{{ openbao_kv_mount }}/data/ai/mcp/splunk" {
  capabilities = ["create", "update", "read"]
}

path "{{ openbao_kv_mount }}/metadata/ai/mcp/splunk" {
  capabilities = ["read"]
}

# KV v2 soft-delete recovery uses a separate update endpoint. Keep this grant
# pinned to the same single secret; no other ai/* path can be undeleted.
path "{{ openbao_kv_mount }}/undelete/ai/mcp/splunk" {
  capabilities = ["update"]
}

# Transitional exact-path exception (Vikunja MCP): the converge publishes the
# minted Vikunja MCP connection here. Same narrow create/update/read on the
# SINGLE secret as the splunk grant above — deliberately NOT a wildcard.
path "{{ openbao_kv_mount }}/data/ai/mcp/vikunja" {
  capabilities = ["create", "update", "read"]
}

path "{{ openbao_kv_mount }}/metadata/ai/mcp/vikunja" {
  capabilities = ["read"]
}

# Each app-agent publisher writes only its exact tier leaf, preserving its
# sibling fields via KV v2 read-modify-write.
{% for tier_path in openbao_app_agent_tier_paths %}
path "{{ openbao_agent_tier_mount }}/data/{{ tier_path }}" {
