{{ ansible_managed | comment }}
path "{{ openbao_kv_mount }}/data/{{ openbao_proxman_secret_path }}" {
  capabilities = ["create", "read", "update"]
}

# OpenBao policy for the ansible-converge AppRole. Reads are enumerated; only
# exact publisher and seed paths are writable, plus the per-app Dify agent key
# leaves under ai/dify/agent-apps/ and MCP URL leaves under ai/dify/agent-mcp/.
# No platform/*, apps/*, or secret/infra/* access is granted.
#
# Consumer inventory: each listed read has a current consumer. Resource-domain
# reads (observability, local-cloud, monitoring, media, apps, local-llm) use the
# shared openbao_secrets role's separate AppRoles and are intentionally absent.
#
#   platform/object-storage: inventory_resolve in proxmox, apps, ai, and splunk
#     reads the tofu-published RustFS inventory artifact.
#   platform/windows-vdi/win11-admin: inventory/load_tofu.yml resolves the
#     WinRM admin password; windows_baseline authenticates with it. Read only.
#   platform/defaults: windows_baseline reads admin_password for VDI admin
#     access. This grants the exact KV object, never platform/defaults/*.
#   apps/nas: nas_storage resolves role-selected Samba username/password for
#     declared SMB shares (main.yml and validate-nas.yml). Read only.
#
# apps/nautobot is granted once by the publication loop below. Do not add a
# duplicate stanza: the publisher grant already includes the required read.

{% for kv_path in ['platform/object-storage', 'platform/windows-vdi/win11-admin', 'platform/defaults', 'apps/nas'] %}
path "{{ openbao_kv_mount }}/data/{{ kv_path }}" {
  capabilities = ["read"]
}

path "{{ openbao_kv_mount }}/metadata/{{ kv_path }}" {
  capabilities = ["read", "list"]
}

{% endfor %}
# Transitional exact-path exception: ansible-splunk's converge publishes the
# shared Splunk MCP connection (SPLUNK_MCP_URL + the minted SPLUNK_MCP_TOKEN)
# here. Narrow create/update/read on the SINGLE secret — deliberately NOT a
# wildcard and NOT blanket secret/ai/* write (that stays with ai-orchestrator).
# `read` is required: the publisher does a read-modify-write to preserve sibling
# fields. This follows the same exact-path scoping pattern as hermes-write.
path "{{ openbao_kv_mount }}/data/ai/mcp/splunk" {
  capabilities = ["create", "update", "read"]
}

path "{{ openbao_kv_mount }}/metadata/ai/mcp/splunk" {
  capabilities = ["read"]
}

# KV v2 soft-delete recovery uses a separate update endpoint. Keep this grant
# pinned to the same single secret; no other ai/* path can be undeleted.
path "{{ openbao_kv_mount }}/undelete/ai/mcp/splunk" {
  capabilities = ["update"]
}

# Transitional exact-path exception (Vikunja MCP): the converge publishes the
# minted Vikunja MCP connection here. Same narrow create/update/read on the
# SINGLE secret as the splunk grant above — deliberately NOT a wildcard.
path "{{ openbao_kv_mount }}/data/ai/mcp/vikunja" {
  capabilities = ["create", "update", "read"]
}

path "{{ openbao_kv_mount }}/metadata/ai/mcp/vikunja" {
  capabilities = ["read"]
}

# Each app-agent publisher writes only its exact tier leaf, preserving its
# sibling fields via KV v2 read-modify-write.
{% for tier_path in openbao_app_agent_tier_paths %}
path "{{ openbao_agent_tier_mount }}/data/{{ tier_path }}" {
  capabilities = ["create", "update", "read"]
}

path "{{ openbao_agent_tier_mount }}/metadata/{{ tier_path }}" {
  capabilities = ["read"]
}
{% endfor %}

# App converge reads login credentials only from their provisioner-only leaves.
{% for login_path in openbao_app_agent_tier_login_paths %}
path "{{ openbao_agent_tier_mount }}/data/{{ login_path }}" {
  capabilities = ["read"]
}

path "{{ openbao_agent_tier_mount }}/metadata/{{ login_path }}" {
  capabilities = ["read"]
}
{% endfor %}

# Exact-path exception (Homebox API key): converge publishes the minted key here.
path "{{ openbao_kv_mount }}/data/homebox/main/rw" {
  capabilities = ["create", "update", "read"]
}

path "{{ openbao_kv_mount }}/metadata/homebox/main/rw" {
  capabilities = ["read"]
}

# Exact-path exception (PBS API token): the PBS role publishes the token used by
# ansible-proxmox to register PBS storage. Keep the writer grant on this secret
# only; the shared ansible-converge identity also reads it during PVE converge.
path "{{ openbao_kv_mount }}/data/platform/pbs/pve-nodes" {
  capabilities = ["create", "read", "update"]
}

path "{{ openbao_kv_mount }}/metadata/platform/pbs/pve-nodes" {
  capabilities = ["read"]
}

# Exact-path exception (dispatch-queue token): the vikunja role publishes the
# queue poller's narrow token here. Same create/update/read on the SINGLE
# secret — not a wildcard.
path "{{ openbao_kv_mount }}/data/ai/vikunja" {
  capabilities = ["create", "update", "read"]
}

path "{{ openbao_kv_mount }}/metadata/ai/vikunja" {
  capabilities = ["read"]
}

# Langfuse's runtime service seed writes only this exact record.
path "{{ openbao_kv_mount }}/data/ai/langfuse" {
  capabilities = ["create", "update", "read"]
}

# Read KV v2 metadata for the same Langfuse record only.
path "{{ openbao_kv_mount }}/metadata/ai/langfuse" {
  capabilities = ["read"]
}

# Langflow's service seed writes only this exact record.
path "{{ openbao_kv_mount }}/data/ai/langflow" {
  capabilities = ["create", "update", "read"]
}

# Read KV v2 metadata for the same Langflow record only.
path "{{ openbao_kv_mount }}/metadata/ai/langflow" {
  capabilities = ["read"]
}

# Phoenix's service seed writes only this exact record.
path "{{ openbao_kv_mount }}/data/ai/phoenix" {
  capabilities = ["create", "update", "read"]
}

# Read KV v2 metadata for the same Phoenix record only.
path "{{ openbao_kv_mount }}/metadata/ai/phoenix" {
  capabilities = ["read"]
}

# Dify's service seed writes only this exact record.
path "{{ openbao_kv_mount }}/data/ai/dify" {
  capabilities = ["create", "update", "read"]
}

# Read KV v2 metadata for the same Dify record only.
path "{{ openbao_kv_mount }}/metadata/ai/dify" {
  capabilities = ["read"]
}

# Dify's agent app key seed writes one leaf per imported catalog app.
path "{{ openbao_kv_mount }}/data/ai/dify/agent-apps/*" {
  capabilities = ["create", "update", "read"]
}

# Read KV v2 metadata for the same Dify agent app leaves only.
path "{{ openbao_kv_mount }}/metadata/ai/dify/agent-apps/*" {
  capabilities = ["read"]
}

# Dify's MCP publish writes one server URL leaf per catalog app.
path "{{ openbao_kv_mount }}/data/ai/dify/agent-mcp/*" {
  capabilities = ["create", "update", "read"]
}

# Read and list KV v2 metadata for the same Dify MCP URL leaves only.
path "{{ openbao_kv_mount }}/metadata/ai/dify/agent-mcp/*" {
  capabilities = ["read", "list"]
}

# Evaluation-only specialist-platform instances: one exact leaf per candidate.
path "{{ openbao_kv_mount }}/data/ai/eval/specialist-platform/sim" {
  capabilities = ["create", "update", "read"]
}

path "{{ openbao_kv_mount }}/metadata/ai/eval/specialist-platform/sim" {
  capabilities = ["read"]
}

path "{{ openbao_kv_mount }}/data/ai/eval/specialist-platform/hermes" {
  capabilities = ["create", "update", "read"]
}

path "{{ openbao_kv_mount }}/metadata/ai/eval/specialist-platform/hermes" {
  capabilities = ["read"]
}

# Transitional exact-path exception (Zammad MCP): the converge publishes the
# minted Zammad MCP connection here. Same narrow create/update/read on the
# SINGLE secret as the splunk grant above — deliberately NOT a wildcard.
path "{{ openbao_kv_mount }}/data/ai/mcp/zammad" {
  capabilities = ["create", "update", "read"]
}

path "{{ openbao_kv_mount }}/metadata/ai/mcp/zammad" {
  capabilities = ["read"]
}

# Transitional exact-path exception (Nautobot MCP): the converge publishes the
# minted Nautobot MCP connection here. Same narrow create/update/read on the
# SINGLE secret as the splunk grant above — deliberately NOT a wildcard.
path "{{ openbao_kv_mount }}/data/ai/mcp/nautobot" {
  capabilities = ["create", "update", "read"]
}

path "{{ openbao_kv_mount }}/metadata/ai/mcp/nautobot" {
  capabilities = ["read"]
}

# Qdrant publishes the memory MCP's collection-scoped token to this one secret.
path "{{ openbao_kv_mount }}/data/ai/mcp/qdrant" {
  capabilities = ["create", "update", "read"]
}

path "{{ openbao_kv_mount }}/metadata/ai/mcp/qdrant" {
  capabilities = ["read"]
}

# Transitional exact-path exception (Hermes bridge identity tokens): the
# vikunja role's hermes_bridge_identity_one.yml publishes each Hermes bridge
# identity's minted token here (e.g. DONNA_VIKUNJA_API_TOKEN). Same narrow
# create/update/read on the SINGLE secret as the grants above — deliberately
# NOT a wildcard, and NOT the broader secret/ai/* access ai-orchestrator
# holds. This path is also written by the separate hermes-write policy (the
# one-time Hermes credential seed); both grants target the same exact secret.
# The Langfuse project-key pair shares this same record and uses that exact
# create/update/read grant.
path "{{ openbao_kv_mount }}/data/ai/hermes" {
  capabilities = ["create", "update", "read"]
}

path "{{ openbao_kv_mount }}/metadata/ai/hermes" {
  capabilities = ["read"]
}

# Transitional exact-path exception (Donna Vikunja bridge token): the vikunja
# role publishes the minted token here. Same narrow create/update/read on the
# SINGLE secret as the grants above — deliberately NOT a wildcard.
path "{{ openbao_kv_mount }}/data/ai/donna" {
  capabilities = ["create", "update", "read"]
}

path "{{ openbao_kv_mount }}/metadata/ai/donna" {
  capabilities = ["read"]
}

# Langfuse project-key pair for the hermes-private agent: the ai-orchestration
# play writes it to this record. Same narrow create/update/read grant as the
# ai/hermes and ai/donna records above — deliberately NOT a wildcard.
path "{{ openbao_kv_mount }}/data/ai/hermes-private" {
  capabilities = ["create", "update", "read"]
}

path "{{ openbao_kv_mount }}/metadata/ai/hermes-private" {
  capabilities = ["read"]
}

# Transitional exact-path exception (Splunk frozen-archive B2 credential): the
# ansible-splunk converge reads the Backblaze B2 credential for the frozen
# archive on the external-SaaS mount. Narrow read on the SINGLE secret —
# deliberately NOT a wildcard. The mount below is the external-SaaS KV v2
# mount and is intentionally a literal path, not the openbao_kv_mount
# variable — that variable names the internal mount, not this one.
path "secrets-external/data/platform/backblaze-splunk" {
  capabilities = ["read"]
}

path "secrets-external/metadata/platform/backblaze-splunk" {
  capabilities = ["read"]
}

# --- The execution plane's run environment -----------------------------------
# One document per mount, each holding the environment variables a converge
# reads, so every value lives on exactly one tier: topology in config/ (already
# readable through config-write), internal-only secrets on the internal mount,
# anything reachable from the public internet on the external mount. The run
# wrapper on the execution plane reads all three at task start and exports
# them; the playbooks read plain environment variables and stay indifferent to
# the store behind them. Exact paths, read only — a converge never writes here.
{% for mount in openbao_platform_env_mounts %}
path "{{ mount }}/data/{{ openbao_platform_env_path }}" {
  capabilities = ["read"]
}

path "{{ mount }}/metadata/{{ openbao_platform_env_path }}" {
  capabilities = ["read"]
}

{% endfor %}
{% include 'ansible-converge-publish-policy.hcl.j2' %}
