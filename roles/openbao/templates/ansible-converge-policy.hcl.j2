# --- The execution plane's run environment -----------------------------------
# One document per mount, each holding the environment variables a converge
# reads, so every value lives on exactly one tier: topology in config/ (already
# readable through config-write), internal-only secrets on the internal mount,
# anything reachable from the public internet on the external mount. The run
# wrapper on the execution plane reads all three at task start and exports
# them; the playbooks read plain environment variables and stay indifferent to
# the store behind them. Exact paths, read only — a converge never writes here.
{% for mount in [openbao_kv_mount, 'secrets-external'] %}
path "{{ mount }}/data/platform/ansible/env" {
  capabilities = ["read"]
}

path "{{ mount }}/metadata/platform/ansible/env" {
  capabilities = ["read"]
}

{% endfor %}
# --- Guest-generated credential publication -----------------------------------
# Several roles mint a credential create-if-absent and keep the ONLY copy in a
# guest-local file, so losing the guest loses the secret. For some of these the
# loss is not merely a password reset — an application encryption key can make
# previously stored credentials permanently undecryptable, and a rotated
# framework SECRET_KEY invalidates every session.
#
# the shared openbao_secrets publish task writes those back here. Grants follow
# the exact-path pattern used above — ENUMERATED, one app per entry, deliberately
# NOT a secret/data/apps/* wildcard, so a converge can never rewrite an app
# credential it does not own. `read` is required for the read-modify-write that
# preserves sibling fields. No `delete`: publishing must never destroy a secret.
{% for leaf in (openbao_credential_publish_apps | map('regex_replace', '^', 'apps/') | list)
               + (openbao_credential_publish_paths | default([])) %}
path "{{ openbao_kv_mount }}/data/{{ leaf }}" {
  capabilities = ["create", "update", "read"]
}

path "{{ openbao_kv_mount }}/metadata/{{ leaf }}" {
  capabilities = ["read"]
}

{% endfor %}
# --- RustFS per-bucket IAM credentials (generate-if-absent) -------------------
# roles/object_storage generates one ro and one rw key pair per bucket in
# object_storage_default_buckets, at secret/rustfs/<bucket>/<ro|rw>
# (the org's secret-path convention — AWS_ACCESS_KEY_ID +
# AWS_SECRET_ACCESS_KEY fields), then reads them back to create the matching
# RustFS IAM user + bucket-scoped policy. Wildcard, unlike the enumerated
# apps/* grants above: the whole secret/rustfs/* subtree holds ONLY these
# generated key pairs (nothing else is filed under the rustfs service name),
# so a wildcard here is already scoped to exactly one purpose. Enumerating
# per bucket instead would need object_storage_default_buckets in scope when
# THIS policy renders (on the OpenBao bootstrap host, which never includes
# the object_storage role) — a cross-role variable dependency this avoids
# entirely. No `delete`: generation never removes a bucket's keys.
path "{{ openbao_kv_mount }}/data/rustfs/*" {
  capabilities = ["create", "update", "read"]
}

path "{{ openbao_kv_mount }}/metadata/rustfs/*" {
  capabilities = ["read", "list"]
}

# --- Patroni's own etcd credential, per cluster (generate-if-absent) ---------
# roles/postgres's patroni_etcd_credential.yml generates Patroni's etcd
# password once per cluster at secret/etcd/<postgres_ha_scope>/rw (the
# ratified <mount>/<service>/<instance>/<role> path grammar, EPIC 887 --
# docs d/conventions/secret-paths), then reads it back on every member so
# all three render an identical patroni.yml. Wildcard, unlike the enumerated
# apps/* grants above: the whole secret/etcd/* subtree holds ONLY these
# generated per-cluster credentials -- no other service is ever filed under
# the etcd name -- so a wildcard here is already scoped to exactly one
# purpose, the same reasoning secret/rustfs/* uses just above. Enumerating
# per cluster instead would need every postgres_ha_scope in scope when THIS
# policy renders (the OpenBao bootstrap host, which never includes the
# postgres role's inventory), a cross-role dependency this avoids entirely.
# No `delete`: generation never removes a cluster's credential.
path "{{ openbao_kv_mount }}/data/etcd/*" {
  capabilities = ["create", "update", "read"]
}

path "{{ openbao_kv_mount }}/metadata/etcd/*" {
  capabilities = ["read", "list"]
}

# --- Patroni's own etcd/PKI certificates, per cluster (issue only) -----------
# roles/postgres's patroni_etcd_tls.yml and patroni_client_tls.yml issue this
# cluster's etcd server/peer cert and Patroni's own client-only cert from the
# PKI mount roles/openbao's 07b-etcd-pki-engine.yml declares for each entry in
# openbao_pki_etcd_engines (empty by default -- no cluster runs patroni mode
# yet, so this loop grants nothing today). ENUMERATED per declared cluster,
# never a Vault ACL glob: OpenBao's `*` glob only ever matches at the very end
# of a path, and `+` only ever replaces one WHOLE path segment -- neither can
# match the scope embedded inside one segment (pki-<scope>-etcd), so a mount
# name that varies per cluster has no valid wildcard shorthand here. Exact
# create/update on issue only -- no sign-verbatim, no root, no access to
# root/generate or the mount's own /roles/* config -- and unlike the KV grant
# above, this list is a roles/openbao-OWN variable, so no cross-role
# dependency: it is already in scope wherever this policy renders.
{% for engine in openbao_pki_etcd_engines %}
path "{{ engine.mount }}/issue/{{ engine.role }}" {
  capabilities = ["create", "update"]
}

path "{{ engine.mount }}/issue/{{ engine.role }}-patroni" {
  capabilities = ["create", "update"]
}

{% endfor %}
