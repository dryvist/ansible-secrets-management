{{ ansible_managed | comment }}
# github-enterprise-read — mint a token from the raw endpoint, pinned to the
# declared installation. No token path exists until the installation ID is set.
{% if openbao_github_enterprise_read_installation_id | length > 0 %}
path "{{ openbao_github_enterprise_read_mount }}/token" {
  capabilities = ["create", "update"]
  required_parameters = ["installation_id"]
  allowed_parameters = { "installation_id" = ["{{ openbao_github_enterprise_read_installation_id }}"] }
}
{% endif %}
