{{ ansible_managed | comment }}
# OpenBao policy for the clickhouse AppRole. Reads only the ClickHouse
# application and reader passwords at the exact internal KV leaf.
path "{{ openbao_kv_mount }}/data/ai/clickhouse" {
  capabilities = ["read"]
}
path "{{ openbao_kv_mount }}/metadata/ai/clickhouse" {
  capabilities = ["read"]
}

# Read-only on the ingest writer password. The clickhouse-ingest AppRole is its other reader.
path "{{ openbao_kv_mount }}/data/ai/clickhouse-ingest" {
  capabilities = ["read"]
}
path "{{ openbao_kv_mount }}/metadata/ai/clickhouse-ingest" {
  capabilities = ["read"]
}
