{{ ansible_managed | comment }}
# openbao-reconcile — the identity an unattended converge uses to keep this
# cluster's declared RBAC in step with the repository.
#
# It is NOT an admin tier. Policy writes are limited to declared names and
# exclude every policy attached to a role the issuer can mint and to this
# identity itself. AppRole writes pin every parameter sent by the role tasks
# to that role's rendered values. Future parameters stay denied, keeping
# reconcile from widening the grants carried by any credential it can obtain
# or use.
#
# The policy and AppRole name sets come from role defaults. Routine converges
# write only names in those sets that satisfy the bounds above; excluded policy
# content and prefix-discovered retirement cleanup require a provisioning run.
# No token or operator action is needed for other eligible declared-name changes.
#
# If this identity is revoked, provisioning skips cleanly rather than failing;
# the cluster keeps serving, it just stops reconciling until someone restores it.

{% set breakglass = openbao_reconcile_excluded_policies | default([]) %}
{% set excluded_policies = openbao_reconcile_policy_excluded_names | default(breakglass) %}
{% set managed_policies = openbao_policies
     | map(attribute='name')
     | reject('in', excluded_policies)
     | list %}
{% set managed_approles = openbao_approles
     | rejectattr('manage_secret_id', 'defined')
     | map(attribute='name')
     | reject('in', breakglass)
     | list %}

# --- Policies this converge owns, by name --------------------------------
# Excluded and therefore unreachable from here: {{ excluded_policies | join(', ') }}
{% for policy_name in managed_policies %}
path "sys/policies/acl/{{ policy_name }}" {
  capabilities = ["create", "read", "update"]
{# No required_parameters here: the ACL applies it to read too, and the
   pre-write read must succeed. The policy API already requires "policy". #}
{% if policy_name == openbao_tofu_state_admin_policy_name %}
  allowed_parameters = {
    "policy" = [{{ (lookup('template', 'tofu-state-admin-policy.hcl.j2') | trim | regex_replace('$', '\n')) | tojson }}]
  }
{% elif policy_name == openbao_github_mount_config_policy_name %}
  allowed_parameters = {
    "policy" = [{{ (lookup('template', 'github-mount-config-policy.hcl.j2') | trim | regex_replace('$', '\n')) | tojson }}]
  }
{% endif %}
}
{% endfor %}
# Retired names carry deletion only, without arbitrary policy administration.
{% for policy_name in openbao_retired_policies | default([]) | reject('in', breakglass) %}
path "sys/policies/acl/{{ policy_name }}" {
  capabilities = ["read", "delete"]
}
{% endfor %}
# Listing is read-only and makes drift visible without granting a write.
path "sys/policies/acl" {
  capabilities = ["list"]
}

# --- AppRoles this converge owns, by name --------------------------------
# Roles carrying manage_secret_id: false are the inert, human-gated tiers and
# are omitted above by that marker rather than by a second hand-kept list —
# one declaration, so a new inert tier cannot be forgotten here.
{% for approle_name in managed_approles %}
{% set approle_cli_parameters = openbao_approle_cli_parameters[approle_name] %}
{% set approle_cidrs = approle_cli_parameters.secret_id_bound_cidrs.split(',')
     | map('trim') | reject('equalto', '') | list %}
{% set required = ['token_policies', 'bind_secret_id'] %}
{% set _ = required.extend([
    'token_ttl', 'token_max_ttl', 'token_explicit_max_ttl', 'token_type',
    'secret_id_ttl', 'secret_id_num_uses'
]) %}
{% if approle_cidrs | length > 0 %}
{% set _ = required.extend(['secret_id_bound_cidrs', 'token_bound_cidrs']) %}
{% endif %}
path "auth/approle/role/{{ approle_name }}" {
  capabilities = ["create", "read", "update"]
  allowed_parameters = {
    "token_policies"          = [{{ approle_cli_parameters.token_policies | tojson }}]
    "bind_secret_id"          = [{{ approle_cli_parameters.bind_secret_id | tojson }}]
{% if approle_cidrs | length > 0 %}
    "secret_id_bound_cidrs"   = [{{ approle_cli_parameters.secret_id_bound_cidrs | tojson }}]
    "token_bound_cidrs"       = [{{ approle_cli_parameters.token_bound_cidrs | tojson }}]
{% endif %}
    "token_ttl"               = [{{ approle_cli_parameters.token_ttl | tojson }}]
    "token_max_ttl"           = [{{ approle_cli_parameters.token_max_ttl | tojson }}]
    "token_explicit_max_ttl"  = [{{ approle_cli_parameters.token_explicit_max_ttl | tojson }}]
    "token_type"              = [{{ approle_cli_parameters.token_type | tojson }}]
    "secret_id_ttl"            = [{{ approle_cli_parameters.secret_id_ttl | tojson }}]
    "secret_id_num_uses"      = [{{ approle_cli_parameters.secret_id_num_uses | tojson }}]
  }
  required_parameters = {{ required | tojson }}
}
path "auth/approle/role/{{ approle_name }}/role-id" {
  capabilities = ["read"]
}
path "auth/approle/role/{{ approle_name }}/policies" {
  capabilities = ["create", "update"]
  allowed_parameters = {
    "token_policies" = [{{ approle_cli_parameters.token_policies | tojson }}]
  }
  required_parameters = ["token_policies"]
}
{% endfor %}
{# These human-gated roles stay out of managed_approles; reconcile changes
   only their policy attachments through the dedicated /policies endpoint. #}
{% set admin_session_policies = openbao_approle_cli_parameters[
    openbao_ai_admin_session_approle_name].token_policies.split(',') %}
path "auth/approle/role/{{ openbao_ai_admin_session_approle_name }}" {
  capabilities = ["read"]
}
path "auth/approle/role/{{ openbao_ai_admin_session_approle_name }}/policies" {
  capabilities = ["update"]
  allowed_parameters = {
    "token_policies" = [{{ admin_session_policies | join(',') | tojson }}]
  }
  required_parameters = ["token_policies"]
}
{% set policy_sync_policies = openbao_approle_cli_parameters[
    openbao_policy_sync_approle_name].token_policies.split(',') %}
path "auth/approle/role/{{ openbao_policy_sync_approle_name }}" {
  capabilities = ["read"]
}
path "auth/approle/role/{{ openbao_policy_sync_approle_name }}/policies" {
  capabilities = ["update"]
  allowed_parameters = {
    "token_policies" = [{{ policy_sync_policies | join(',') | tojson }}]
  }
  required_parameters = ["token_policies"]
}
{% for approle_name in openbao_retired_approles | default([]) | reject('in', breakglass) %}
path "auth/approle/role/{{ approle_name }}" {
  capabilities = ["read", "delete"]
}
{% endfor %}
# Listing names only (no role definitions, no credentials) is how the converge
# notices an AppRole that exists in the store but was never enumerated above —
# the enumerate-by-name design above means such a role is otherwise invisible
# to every future reconcile. Read-only, same reasoning as the policy list line.
path "auth/approle/role" {
  capabilities = ["list"]
}

# Retired Terrakube JWT roles, by retired prefix only.
path "auth/{{ openbao_terrakube_jwt_auth_path }}/role/{{ openbao_retired_terrakube_prefix }}*" {
  capabilities = ["read", "delete"]
}
path "auth/{{ openbao_terrakube_jwt_auth_path }}/role" {
  capabilities = ["list"]
}

# --- SSH signing roles, by name ------------------------------------------
# Without these the identity cannot perform the SSH-role reconcile, which is
# one of the jobs it exists to do — and the omission would only surface as a
# 403 partway through a converge nobody was watching. Enumerated by name for
# the same reason as everything else here: `{{ openbao_ssh_mount }}/roles/*`
# would let it invent a role with any principal it liked, including one the
# host CA trusts for root.
{% for ssh_role in openbao_ssh_roles %}
path "{{ openbao_ssh_mount }}/roles/{{ ssh_role.name }}" {
  capabilities = ["create", "read", "update"]
}
{% endfor %}
# The agents mount's retired set is removed by the declared-set reconcile.
path "github-agents/permissionset/agents-write" {
  capabilities = ["read", "delete"]
}

# --- Mounts, by name -----------------------------------------------------
# Reconcile may create only the declared OpenTofu Transit mount.
path "sys/mounts/{{ openbao_transit_mount }}" {
  capabilities = ["read", "update"]
}
# Mount creation needs update on exact sys/mounts/<path>; tuning/auth changes stay break-glass.
# Root-protected API endpoints: https://openbao.org/docs/concepts/policies/#root-protected-api-endpoints
path "sys/mounts" {
  capabilities = ["read", "list"]
}
path "sys/auth" {
  capabilities = ["read", "list"]
}

# --- Engine content the converge seeds -----------------------------------
# Updating a state key cannot change exportability or deletion (those are under /config, not granted); reconcile cannot delete a key.
path "{{ openbao_transit_mount }}/keys/{{ openbao_tofu_state_transit_key }}" {
  capabilities = ["read", "update"]
}
path "{{ openbao_transit_mount }}/keys/{{ openbao_github_org_secrets_state_transit_key }}" {
  capabilities = ["read", "update"]
}
{# KV paths are the declared seed and promotion targets that init/03 actually touches. #}
{% set kv_data_grants = {} %}
{% for app in (openbao_promoted_app_secrets | default({})).keys() %}
{% set _ = kv_data_grants.update({openbao_kv_mount ~ '/data/apps/' ~ app: ['create', 'read', 'update']}) %}
{% endfor %}
{% for app in (openbao_promoted_external_secrets | default({})).keys() %}
{% set _ = kv_data_grants.update({'secrets-external/data/' ~ app: ['create', 'read', 'update']}) %}
{% endfor %}
{% for path in (openbao_promoted_config_values | default({})).keys() %}
{% set _ = kv_data_grants.update({openbao_config_mount ~ '/data/' ~ path: ['create', 'read', 'update']}) %}
{% endfor %}
{% for app in (openbao_seeded_generated_app_secrets | default({})).keys() %}
{% set seed_path = openbao_generated_app_secret_paths | default({}) %}
{% set seed_path = seed_path.get(app, 'apps/' ~ app) %}
{% set _ = kv_data_grants.update({openbao_kv_mount ~ '/data/' ~ seed_path: ['create', 'read', 'update']}) %}
{% endfor %}
{% for app in (openbao_roster_agent_generated_app_secrets | default({})).keys() %}
{% set _ = kv_data_grants.update({openbao_kv_mount ~ '/data/apps/' ~ app: ['create', 'read', 'update']}) %}
{% endfor %}
{% for app in (openbao_caller_gateway_generated_app_secrets | default({})).keys() %}
{% set _ = kv_data_grants.update({openbao_kv_mount ~ '/data/apps/' ~ app: ['create', 'read', 'update']}) %}
{% endfor %}
{# Exact read-only KV leaves, declared once in openbao_reconcile_read_leaves as
   mount:path. A grant built above keeps its own capabilities. #}
{% for leaf in openbao_reconcile_read_leaves %}
{% set _mount = leaf.split(':', 1)[0] %}
{% set _path = leaf.split(':', 1)[1] %}
{% set _ = kv_data_grants.setdefault(_mount ~ '/data/' ~ _path, ['read']) %}
{% endfor %}
{% for path in kv_data_grants | sort %}
path "{{ path }}" {
  capabilities = {{ kv_data_grants[path] | tojson }}
}
{% endfor %}
# Exact KV v2 config paths declared for retention; the tuning task updates max_versions.
{% for mount in openbao_kv_tuned_mounts | default([]) %}
path "{{ mount.path | default(mount) }}/config" {
  capabilities       = ["read", "update"]
  allowed_parameters = {
    "max_versions" = [{{ mount.max_versions | string | tojson }}]
  }
}
{% endfor %}
# The rotation-exempt marker and roster leaf ownership require exact metadata
# PATCH paths.
{% set kv_metadata_grants = {} %}
{% for entry in openbao_rotation_exempt | default([]) %}
{% set metadata_path = entry.split(':', 1) %}
{% set _ = kv_metadata_grants.update({metadata_path[0] ~ '/metadata/' ~ metadata_path[1]: ['read', 'patch']}) %}
{% endfor %}
{% for app in (openbao_roster_agent_generated_app_secrets | default({})).keys() %}
{% set _ = kv_metadata_grants.update({openbao_kv_mount ~ '/metadata/apps/' ~ app: ['read', 'patch']}) %}
{% endfor %}
{% for app in (openbao_caller_gateway_generated_app_secrets | default({})).keys() %}
{% set _ = kv_metadata_grants.update({openbao_kv_mount ~ '/metadata/apps/' ~ app: ['read', 'patch']}) %}
{% endfor %}
{% for agent in (openbao_ai_agents | default({})).keys() %}
{% if (agent | string | regex_search(openbao_roster_agent_name_pattern)) is not none %}
{% set _ = kv_metadata_grants.update({openbao_kv_mount ~ '/metadata/ai/' ~ agent: ['read']}) %}
{% endif %}
{% endfor %}
{% for path in kv_metadata_grants | sort %}
path "{{ path }}" {
  capabilities       = {{ kv_metadata_grants[path] | tojson }}
{% if 'patch' in kv_metadata_grants[path] or 'update' in kv_metadata_grants[path] %}
  allowed_parameters = {
    "custom_metadata" = []
  }
{% endif %}
}
{% endfor %}
{% for reader in openbao_app_agent_tier_readers %}
path "{{ openbao_agent_tier_mount }}/data/{{ reader.tier }}" {
  capabilities = ["create", "read", "update"]
}
path "{{ openbao_agent_tier_mount }}/metadata/{{ reader.tier }}" {
  capabilities = ["read"]
}
{% if reader.login_path is defined %}
path "{{ openbao_agent_tier_mount }}/data/{{ reader.login_path }}" {
  capabilities = ["create", "read", "update"]
}
path "{{ openbao_agent_tier_mount }}/metadata/{{ reader.login_path }}" {
  capabilities = ["read"]
}
{% endif %}
{% endfor %}
# Permission sets are named objects on the GitHub engine, not the raw token
# endpoint — minting a token is a consumer's job, never the reconciler's.
{% for _github_mount in [openbao_github_mount]
     + (openbao_github_app_mounts | default([]) | map(attribute='mount') | list) %}
path "{{ _github_mount }}/permissionset/*" {
  capabilities = ["create", "read", "update", "list"]
}
{% endfor %}
