{{ ansible_managed | comment }}
# openbao-reconcile — the identity an unattended converge uses to keep this
# cluster's declared RBAC in step with the repository.
#
# It is NOT an admin tier. Policy writes are limited to declared names and
# exclude every policy attached to a role the issuer can mint and to this
# identity itself. AppRole writes pin the rendered token policies, binding flag,
# and CIDR bounds; the remaining parameters sent by the role tasks are named
# explicitly so future parameters stay denied. This keeps reconcile from
# widening the grants carried by any credential it can obtain or use.
#
# The policy and AppRole name sets come from role defaults. Routine converges
# write only names in those sets that satisfy the bounds above; excluded policy
# content and prefix-discovered retirement cleanup require a provisioning run.
# No token or operator action is needed for other eligible declared-name changes.
#
# If this identity is revoked, provisioning skips cleanly rather than failing;
# the cluster keeps serving, it just stops reconciling until someone restores it.

{% set breakglass = openbao_reconcile_excluded_policies | default([]) %}
{% set excluded_policies = openbao_reconcile_policy_excluded_names | default(breakglass) %}
{% set managed_policies = openbao_policies
     | map(attribute='name')
     | reject('in', excluded_policies)
     | list %}
{% set managed_approles = openbao_approles
     | rejectattr('manage_secret_id', 'defined')
     | map(attribute='name')
     | reject('in', breakglass)
     | list %}

# --- Policies this converge owns, by name --------------------------------
# Excluded and therefore unreachable from here: {{ excluded_policies | join(', ') }}
{% for policy_name in managed_policies %}
path "sys/policies/acl/{{ policy_name }}" {
  capabilities = ["create", "read", "update"]
}
{% endfor %}
# Retired names carry deletion only, without arbitrary policy administration.
{% for policy_name in openbao_retired_policies | default([]) | reject('in', breakglass) %}
path "sys/policies/acl/{{ policy_name }}" {
  capabilities = ["read", "delete"]
}
{% endfor %}
# Listing is read-only and makes drift visible without granting a write.
path "sys/policies/acl" {
  capabilities = ["list"]
}

# --- AppRoles this converge owns, by name --------------------------------
# Roles carrying manage_secret_id: false are the inert, human-gated tiers and
# are omitted above by that marker rather than by a second hand-kept list —
# one declaration, so a new inert tier cannot be forgotten here.
{% for approle_name in managed_approles %}
{% set approle = openbao_approles | selectattr('name', 'equalto', approle_name) | first %}
{% set token_policies = approle.token_policies | default([approle.policy]) %}
{% set bind_secret_id = (approle.bind_secret_id | default(openbao_approle_bind_secret_id) | string | lower) == 'true' %}
{% set approle_cidr_class = openbao_approle_cidr_class_map[approle_name] %}
{% set approle_cidr_csv = approle.secret_id_bound_cidrs | default('', true)
     or openbao_approle_cidr_classes[approle_cidr_class] %}
{% set approle_cidrs = approle_cidr_csv.split(',') | map('trim') | reject('equalto', '') | list %}
{% set required = ['token_policies', 'bind_secret_id'] %}
{% if approle_cidrs | length > 0 %}
{% set _ = required.extend(['secret_id_bound_cidrs', 'token_bound_cidrs']) %}
{% endif %}
path "auth/approle/role/{{ approle_name }}" {
  capabilities = ["create", "read", "update"]
  allowed_parameters = {
    "token_policies"          = [{{ token_policies | tojson }}]
    "bind_secret_id"          = [{{ bind_secret_id | tojson }}]
    "secret_id_bound_cidrs"   = [{{ approle_cidrs | tojson }}]
    "token_bound_cidrs"       = [{{ approle_cidrs | tojson }}]
    "token_ttl"               = []
    "token_max_ttl"           = []
    "token_explicit_max_ttl"  = []
    "token_type"              = []
    "secret_id_ttl"            = []
    "secret_id_num_uses"      = []
  }
  required_parameters = {{ required | tojson }}
}
path "auth/approle/role/{{ approle_name }}/role-id" {
  capabilities = ["read"]
}
path "auth/approle/role/{{ approle_name }}/policies" {
  capabilities = ["create", "update"]
  allowed_parameters = {
    "token_policies" = [{{ token_policies | tojson }}]
  }
  required_parameters = ["token_policies"]
}
{% endfor %}
{% for approle_name in openbao_retired_approles | default([]) | reject('in', breakglass) %}
path "auth/approle/role/{{ approle_name }}" {
  capabilities = ["read", "delete"]
}
{% endfor %}
# Listing names only (no role definitions, no credentials) is how the converge
# notices an AppRole that exists in the store but was never enumerated above —
# the enumerate-by-name design above means such a role is otherwise invisible
# to every future reconcile. Read-only, same reasoning as the policy list line.
path "auth/approle/role" {
  capabilities = ["list"]
}

# Retired Terrakube JWT roles, by retired prefix only.
path "auth/{{ openbao_terrakube_jwt_auth_path }}/role/{{ openbao_retired_terrakube_prefix }}*" {
  capabilities = ["read", "delete"]
}
path "auth/{{ openbao_terrakube_jwt_auth_path }}/role" {
  capabilities = ["list"]
}

# --- SSH signing roles, by name ------------------------------------------
# Without these the identity cannot perform the SSH-role reconcile, which is
# one of the jobs it exists to do — and the omission would only surface as a
# 403 partway through a converge nobody was watching. Enumerated by name for
# the same reason as everything else here: `{{ openbao_ssh_mount }}/roles/*`
# would let it invent a role with any principal it liked, including one the
# host CA trusts for root.
{% for ssh_role in openbao_ssh_roles %}
path "{{ openbao_ssh_mount }}/roles/{{ ssh_role.name }}" {
  capabilities = ["create", "read", "update"]
}
{% endfor %}
# The agents mount's retired set is removed by the declared-set reconcile.
path "github-agents/permissionset/agents-write" {
  capabilities = ["read", "delete"]
}

# --- Mounts, by name -----------------------------------------------------
# Reconcile may create only the declared OpenTofu Transit mount.
path "sys/mounts/{{ openbao_transit_mount }}" {
  capabilities = ["read", "update"]
}
# Mount creation needs update on exact sys/mounts/<path>; tuning/auth changes stay break-glass.
# Root-protected API endpoints: https://openbao.org/docs/concepts/policies/#root-protected-api-endpoints
path "sys/mounts" {
  capabilities = ["read", "list"]
}
path "sys/auth" {
  capabilities = ["read", "list"]
}

# --- Engine content the converge seeds -----------------------------------
# Updating keys/tofu-state cannot change exportability or deletion (those are under /config, not granted); reconcile cannot delete the key.
path "{{ openbao_transit_mount }}/keys/{{ openbao_tofu_state_transit_key }}" {
  capabilities = ["read", "update"]
}
{% for mount in openbao_kv_mounts | default([]) %}
path "{{ mount.path | default(mount) }}/*" {
  capabilities = ["create", "read", "update", "list"]
}
# The rotation-exempt marker (tasks/tag_rotation_exempt.yml) is a metadata
# PATCH. This longer prefix REPLACES the wildcard's list for metadata/, so it
# re-states read+list and deliberately drops create/update: nothing here PUTs
# metadata, and a full metadata write carries the version-destroy knobs.
# `allowed_parameters` confines the PATCH body to `custom_metadata` for the
# same reason the rotator policies do (see apps-rotate-policy.hcl.j2).
path "{{ mount.path | default(mount) }}/metadata/*" {
  capabilities       = ["read", "list", "patch"]
  allowed_parameters = { "custom_metadata" = [] }
}
{% endfor %}
# Permission sets are named objects on the GitHub engine, not the raw token
# endpoint — minting a token is a consumer's job, never the reconciler's.
{% for _github_mount in [openbao_github_mount]
     + (openbao_github_app_mounts | default([]) | map(attribute='mount') | list) %}
path "{{ _github_mount }}/permissionset/*" {
  capabilities = ["create", "read", "update", "list"]
}
{% endfor %}
