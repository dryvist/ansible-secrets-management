{{ ansible_managed | comment }}
# OpenBao policy for the `agent-workstation` AppRole.
path "{{ openbao_kv_mount }}/data/apps/nautobot" {
  capabilities = ["read"]
}
path "{{ openbao_kv_mount }}/data/ai/mcp" {
  capabilities = ["read"]
}
# YouTrack service API token for agent use.
path "{{ openbao_kv_mount }}/data/ai/youtrack" {
  capabilities = ["read"]
}
# Dify agent app API keys.
path "{{ openbao_kv_mount }}/data/ai/dify/agent-apps/*" {
  capabilities = ["read"]
}
